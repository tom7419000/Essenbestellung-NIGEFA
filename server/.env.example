# ------------------------------------------------------------------
# Server-Konfiguration – Kopie als server/.env ablegen.
# Bereits gesetzte Umgebungsvariablen haben Vorrang vor dieser Datei.
# ------------------------------------------------------------------

# PORT=3001              # unter Plesk/Passenger von der Plattform gesetzt – nicht überschreiben
# APP_TIMEZONE=Europe/Berlin
# JWT_SECRET=            # sonst automatisch generiert (<DATA_DIR>/.jwt-secret)
# DATA_DIR=              # Verzeichnis für DB/JWT-Secret/Branding (Standard: server/data).
#                        # Auf Plesk am besten AUSSERHALB des Document Root, z. B.
#                        # /var/www/vhosts/<domain>/essenportal-data
# VAPID_SUBJECT=mailto:admin@example.com   # Kontakt für Web-Push (Standard mailto:admin@localhost)

# ---- Erstes Admin-Konto (Produktion, ohne Demo-Daten) ----
# Von `npm run create-admin --prefix server` genutzt, falls keine CLI-Argumente
# übergeben werden. Nach dem ersten Login das Passwort ändern.
# ADMIN_USER=admin
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=Administrator

# ---- Single Sign-On (Microsoft Entra ID) ----
# Wird jetzt im Admin-Bereich konfiguriert (Admin -> Anmeldung (SSO)),
# inkl. Verbundanmeldeinformation und "Verbindung testen".
# Siehe docs/sso-entra-id.md.
#
# Die folgenden Variablen sind nur ein FALLBACK für bestehende
# Installationen; im Admin-Bereich gesetzte Werte haben Vorrang.
# ENTRA_CLIENT_ID=
# ENTRA_TENANT_ID=

# Optional: "0" = unbekannte E-Mail-Adressen NICHT automatisch als
# Benutzer anlegen (Standard: neue SSO-Nutzer werden mit Rolle
# "Benutzer" angelegt; Benutzername = E-Mail-Adresse).
ENTRA_AUTO_CREATE=
