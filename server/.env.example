# ------------------------------------------------------------------
# Server-Konfiguration – Kopie als server/.env ablegen.
# Bereits gesetzte Umgebungsvariablen haben Vorrang vor dieser Datei.
# ------------------------------------------------------------------

# PORT=3001
# APP_TIMEZONE=Europe/Berlin
# JWT_SECRET=            # sonst automatisch generiert (server/data/.jwt-secret)

# Microsoft Entra ID (Azure AD) – Single Sign-On.
# Muss zu den VITE_ENTRA_-Werten des Clients passen (gleiche App-Registrierung).
# Beide IDs leer lassen, um SSO serverseitig zu deaktivieren.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Optional: "0" = unbekannte E-Mail-Adressen NICHT automatisch als
# Benutzer anlegen (Standard: neue SSO-Nutzer werden mit Rolle
# "Benutzer" angelegt; Benutzername = E-Mail-Adresse).
ENTRA_AUTO_CREATE=

# Nur für Sonderfälle/Tests: abweichende JWKS-URL bzw. Issuer.
# ENTRA_JWKS_URL=
# ENTRA_ISSUER=
