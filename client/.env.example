# ------------------------------------------------------------------
# Frontend-Konfiguration (Vite) – Kopie als client/.env ablegen.
# VITE_-Variablen werden BEIM BUILD eingebettet; nach Änderungen also
# "npm run build" (bzw. den Dev-Server) neu starten.
# ------------------------------------------------------------------

# Microsoft Entra ID (Azure AD) – Single Sign-On.
# Beide IDs leer lassen, um SSO zu deaktivieren (nur lokale Anmeldung).
# Woher die Werte kommen: siehe docs/sso-entra-id.md
#   Azure-Portal -> App-Registrierung -> Übersicht:
#     "Anwendungs-ID (Client)"        -> VITE_ENTRA_CLIENT_ID
#     "Verzeichnis-ID (Mandant)"      -> VITE_ENTRA_TENANT_ID
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=

# Muss EXAKT einer in Azure hinterlegten Redirect-URI entsprechen
# (Plattform "Single-Page-Anwendung"). Beispiele:
#   Entwicklung:  http://localhost:5173
#   Produktion:   https://essen.example.de
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Optional: "1" = Login-Seite leitet Nutzer ohne Sitzung automatisch
# zum Microsoft-Login weiter (statt Button + lokalem Formular).
VITE_ENTRA_AUTO_REDIRECT=
