# ============================================================
# NIGEFA Essensbestellung — zentrale Konfiguration
# Kopieren nach .env — Werte mit ⚠️ in Produktion zwingend ändern!
# ============================================================

# --- PostgreSQL (Docker-Compose-Service "db") ---
POSTGRES_USER=nigefa
POSTGRES_PASSWORD=nigefa            # ⚠️
POSTGRES_DB=nigefa

# --- Backend ---
PORT=4000
DB_HOST=db                          # lokal ohne Docker: localhost
DB_PORT=5432
DB_USER=nigefa
DB_PASSWORD=nigefa                  # ⚠️
DB_NAME=nigefa
DB_SYNCHRONIZE=true                 # Produktion mit Migrationen: false

JWT_ACCESS_SECRET=dev-access-secret-change-me     # ⚠️ openssl rand -hex 48
JWT_REFRESH_SECRET=dev-refresh-secret-change-me   # ⚠️ openssl rand -hex 48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Frontend-Origin (CORS + Links in E-Mails)
APP_URL=http://localhost:3000

# SMTP — Standard: MailHog aus docker-compose (UI: http://localhost:8025)
SMTP_HOST=mailhog                   # lokal ohne Docker: localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Essensbestellung <noreply@nigefa.de>

# Cron-Jobs (bei mehreren Backend-Replikaten nur auf einer Instanz true)
SCHEDULER_ENABLED=true

# Optional: Web-Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:kontakt@nigefa.de

# --- Frontend (Build-Argument!) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
